---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import projects from '../data/projects.json';
import fs from 'node:fs';
import path from 'node:path';

const visibleProjects = projects
  .filter((project) => !project.hidden)
  .sort((a, b) => {
    const orderA = Number.isInteger(a.order) ? a.order : Number.POSITIVE_INFINITY;
    const orderB = Number.isInteger(b.order) ? b.order : Number.POSITIVE_INFINITY;

    return orderA - orderB;
  });

const categories = [
  ...new Set(visibleProjects.map((project) => project.category).filter(Boolean)),
];

const featuredProject =
  visibleProjects.find((project) => project.featured) ||
  visibleProjects.find((project) => project.slug === 'the-matchbox-house') ||
  visibleProjects[0];

const featuredImage = featuredProject?.hero || featuredProject?.cover;
const featuredAlt =
  featuredProject?.hero_alt ||
  featuredProject?.cover_alt ||
  featuredProject?.title;

const IMAGE_WIDTHS = [480, 768, 1024, 1440, 1920, 2560];

const publicImageExists = (src) => {
  if (!src || !src.startsWith('/')) {
    return false;
  }

  try {
    return fs.existsSync(path.join(process.cwd(), 'public', decodeURIComponent(src).replace(/^\/+/, '')));
  } catch {
    return false;
  }
};

const optimizedImage = (src) => {
  if (!src || !/\.(jpe?g|png|webp|avif)$/i.test(src)) {
    return {
      original: src,
      avif: null,
      webp: null,
      avifSrcset: null,
      webpSrcset: null,
    };
  }

  const withoutExtension = src
    .replace(/\.(jpe?g|png|webp|avif)$/i, '')
    .replace(/-(480|768|1024|1440|1920|2560)$/i, '');
  const isAvif = /\.avif$/i.test(src);
  const avif = isAvif ? src : `${withoutExtension}.avif`;
  const webp = `${withoutExtension}.webp`;
  const avifSrcset = IMAGE_WIDTHS
    .map((width) => `${withoutExtension}-${width}.avif`)
    .filter(publicImageExists)
    .map((image) => `${image} ${image.match(/-(480|768|1024|1440|1920|2560)\.avif$/i)?.[1]}w`)
    .join(', ');
  const webpSrcset = IMAGE_WIDTHS
    .map((width) => `${withoutExtension}-${width}.webp`)
    .filter(publicImageExists)
    .map((image) => `${image} ${image.match(/-(480|768|1024|1440|1920|2560)\.webp$/i)?.[1]}w`)
    .join(', ');

  return {
    original: src,
    avif: publicImageExists(avif) ? avif : null,
    webp: publicImageExists(webp) ? webp : null,
    avifSrcset: avifSrcset || null,
    webpSrcset: webpSrcset || null,
  };
};

const featuredSocialSources = optimizedImage(featuredImage);
const homeDescription =
  'Selected architecture, interior design and visualization projects by SeenPleen Studio in Patras, Greece.';
---

<BaseLayout
  title="SeenPleen Studio | Architecture & Interior Design"
  description={homeDescription}
  image={featuredSocialSources.avif || featuredSocialSources.webp || featuredImage}
  imageAlt={featuredAlt}
>
  <Header />

  {featuredProject && featuredImage && (
    <section class="home-hero is-revealed">
      {(() => {
        const heroSources = optimizedImage(featuredImage);

        return (
          <picture>
            {heroSources.avifSrcset && (
              <source
                srcset={heroSources.avifSrcset}
                sizes="100vw"
                type="image/avif"
              />
            )}
            {heroSources.webpSrcset && (
              <source
                srcset={heroSources.webpSrcset}
                sizes="100vw"
                type="image/webp"
              />
            )}
            <img
              src={heroSources.avif || heroSources.webp || featuredImage}
              alt={featuredAlt}
              class="home-hero-image"
              loading="eager"
              fetchpriority="high"
            />
          </picture>
        );
      })()}

      <div class="home-hero-overlay">
        <a href={`/projects/${featuredProject.slug}/`} class="home-hero-link">
          <span class="home-hero-title">{featuredProject.title}</span>
        </a>
      </div>
    </section>
  )}

  <section class="projects-section" id="projects">
    <div class="projects-heading reveal-item">
      <div>
        <span>Selected Works</span>
        <h2>Projects</h2>
      </div>

      {categories.length > 0 && (
        <div class="projects-filters" aria-label="Project filters">
          <button type="button" class="projects-filter is-active" data-filter="all">
            All
          </button>

          {categories.map((category) => (
            <button type="button" class="projects-filter" data-filter={category}>
              {category}
            </button>
          ))}
        </div>
      )}
    </div>

    <div class="projects-grid">
      {visibleProjects.map((p, index) => {
        const hoverMeta = [
          p.category,
          p.subcategory,
          p.year,
        ].filter(Boolean);

        const coverSources = optimizedImage(p.cover);

        return (
          <a
            class="project-card reveal-item"
            href={`/projects/${p.slug}/`}
            data-category={p.category || ''}
            style={`--reveal-delay: ${Math.min(index * 45, 360)}ms`}
          >
            <div class="project-card-image">
              {p.cover ? (
                <picture>
                  {coverSources.avifSrcset && (
                    <source
                      srcset={coverSources.avifSrcset}
                      sizes="(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 25vw"
                      type="image/avif"
                    />
                  )}
                  {coverSources.webpSrcset && (
                    <source
                      srcset={coverSources.webpSrcset}
                      sizes="(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 25vw"
                      type="image/webp"
                    />
                  )}
                  <img
                    src={coverSources.avif || coverSources.webp || p.cover}
                    alt={p.cover_alt || p.title}
                    loading={index === 0 ? 'eager' : 'lazy'}
                  />
                </picture>
              ) : (
                <div class="project-card-placeholder"></div>
              )}

              <div class="project-card-hover">
                <div class="project-card-hover-inner">
                  <h3>{p.title}</h3>

                  {hoverMeta.length > 0 && (
                    <p>{hoverMeta.join(' / ')}</p>
                  )}
                </div>
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </section>

  <Footer />

  <script>
    const filterButtons = document.querySelectorAll('.projects-filter');
    const projectCards = document.querySelectorAll('.project-card');

    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const selectedCategory = button.getAttribute('data-filter');

        filterButtons.forEach((item) => item.classList.remove('is-active'));
        button.classList.add('is-active');

        projectCards.forEach((card) => {
          const cardCategory = card.getAttribute('data-category');
          const shouldShow =
            selectedCategory === 'all' || cardCategory === selectedCategory;

          card.classList.toggle('is-hidden', !shouldShow);
        });
      });
    });

    const revealItems = document.querySelectorAll('.reveal-item');

    const revealObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-revealed');
            revealObserver.unobserve(entry.target);
          }
        });
      },
      {
        threshold: 0.12,
      }
    );

    revealItems.forEach((item) => revealObserver.observe(item));
  </script>
</BaseLayout>
