---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getProjects } from '../../lib/projects';
import fs from 'node:fs';
import path from 'node:path';

export async function getStaticPaths() {
  const projects = await getProjects();
  const visibleProjects = projects.filter((project) => !project.hidden);

  return visibleProjects.map((project, index) => {
    const projectCount = visibleProjects.length;

    return {
      params: {
        slug: project.slug,
      },
      props: {
        project,
        previousProject: visibleProjects[(index - 1 + projectCount) % projectCount],
        nextProject: visibleProjects[(index + 1) % projectCount],
        alternateProject: visibleProjects[(index + 2) % projectCount],
      },
    };
  });
}

const { project, previousProject, nextProject, alternateProject } = Astro.props;

const heroMedia = project.hero_media;
const heroVideo = heroMedia?.mimeType?.startsWith('video/') ? heroMedia.url : null;
const heroImage =
  (!heroVideo && heroMedia?.url) ||
  project.hero ||
  project.cover ||
  project.gallery_uploads?.[0] ||
  project.gallery?.[0]?.url;
const heroPosterImage =
  project.cover ||
  project.hero ||
  project.gallery_uploads?.[0] ||
  project.gallery?.[0]?.url;

const heroAlt =
  heroMedia?.alt ||
  project.hero_alt ||
  project.cover_alt ||
  project.title;

const heroMeta = [
  project.category,
  project.subcategory,
  project.location,
  project.year,
].filter(Boolean);

const detailParagraphs = project.details
  ? project.details.split('\n').filter((paragraph) => paragraph.trim().length > 0)
  : [];

const projectQuotes = (project.quotes || [])
  .map((quote) => (typeof quote === 'string' ? quote : quote?.quote))
  .filter((quote) => quote && String(quote).trim().length > 0);

const projectMeta = [
  { label: 'Category', value: project.category },
  { label: 'Subcategory', value: project.subcategory },
  { label: 'Client', value: project.client },
  { label: 'Location', value: project.location },
  { label: 'Year', value: project.year },
  { label: 'Area', value: project.area },
  { label: 'Status', value: project.status },
].filter((item) => item.value && String(item.value).trim().length > 0);

const collaborators = project.collaborators || {};

const projectCollaborators = [
  { label: 'Architect Engineer', value: collaborators.architect_engineer },
  { label: 'Civil Engineer', value: collaborators.civil_engineer },
  { label: 'Mechanical Engineer', value: collaborators.mechanical_engineer },
  { label: 'Construction', value: collaborators.construction },
  { label: 'Photographer', value: collaborators.photographer },
  { label: '3D Artist', value: collaborators.artist_3d },
  { label: 'Decoration', value: collaborators.decoration },
  { label: 'Lighting Design', value: collaborators.lighting_design },
].filter((item) => item.value && String(item.value).trim().length > 0);

const IMAGE_WIDTHS = [480, 768, 1024, 1440, 1920, 2560];

const isExternalImage = (src) => /^https?:\/\//i.test(src || '');

const publicImageExists = (src) => {
  if (isExternalImage(src)) {
    return true;
  }

  if (!src || !src.startsWith('/')) {
    return false;
  }

  try {
    return fs.existsSync(path.join(process.cwd(), 'public', decodeURIComponent(src).replace(/^\/+/, '')));
  } catch {
    return false;
  }
};

const encodeImageUrl = (src) => {
  if (!src || !src.startsWith('/')) {
    return src;
  }

  return src
    .split('/')
    .map((part, index) => (index === 0 ? part : encodeURIComponent(decodeURIComponent(part))))
    .join('/');
};

const normalizeGalleryUrl = (src) => {
  if (!src || typeof src !== 'string') {
    return '';
  }

  try {
    return decodeURIComponent(src).toLowerCase();
  } catch {
    return src.toLowerCase();
  }
};

const uniqueGalleryItems = (items) => {
  const seenUrls = new Set();

  return items.filter((item) => {
    const normalizedUrl = normalizeGalleryUrl(item.url);

    if (!normalizedUrl || seenUrls.has(normalizedUrl)) {
      return false;
    }

    seenUrls.add(normalizedUrl);
    return true;
  });
};

const bulkGallery = (project.gallery_uploads || [])
  .filter(publicImageExists)
  .map((url) => ({
    url,
    title: '',
    alt: '',
    layout: 'auto',
  }));

const detailedGallery = (project.gallery || []).filter((img) => publicImageExists(img.url));
const gallery = uniqueGalleryItems([...bulkGallery, ...detailedGallery]);
const panoramaImages = (project.panorama_images || []).filter((image) => image?.url);
const hasPanoramaImages = panoramaImages.length > 0;
const panoramaCss = hasPanoramaImages
  ? fs.readFileSync(path.join(process.cwd(), 'node_modules', 'pannellum', 'build', 'pannellum.css'), 'utf8')
  : '';

const optimizedImage = (src) => {
  if (isExternalImage(src)) {
    return {
      original: src,
      avif: null,
      webp: null,
      avifSrcset: null,
      webpSrcset: null,
    };
  }

  if (!src || !/\.(jpe?g|png|webp|avif)$/i.test(src)) {
    return {
      original: src,
      avif: null,
      webp: null,
      avifSrcset: null,
      webpSrcset: null,
    };
  }

  const withoutExtension = src
    .replace(/\.(jpe?g|png|webp|avif)$/i, '')
    .replace(/-(480|768|1024|1440|1920|2560)$/i, '');
  const isAvif = /\.avif$/i.test(src);
  const avif = isAvif ? src : `${withoutExtension}.avif`;
  const webp = `${withoutExtension}.webp`;
  const avifSrcset = IMAGE_WIDTHS
    .map((width) => `${withoutExtension}-${width}.avif`)
    .filter(publicImageExists)
    .map((image) => `${encodeImageUrl(image)} ${image.match(/-(480|768|1024|1440|1920|2560)\.avif$/i)?.[1]}w`)
    .join(', ');
  const webpSrcset = IMAGE_WIDTHS
    .map((width) => `${withoutExtension}-${width}.webp`)
    .filter(publicImageExists)
    .map((image) => `${encodeImageUrl(image)} ${image.match(/-(480|768|1024|1440|1920|2560)\.webp$/i)?.[1]}w`)
    .join(', ');

  return {
    original: encodeImageUrl(src),
    avif: publicImageExists(avif) ? encodeImageUrl(avif) : null,
    webp: publicImageExists(webp) ? encodeImageUrl(webp) : null,
    avifSrcset: avifSrcset || null,
    webpSrcset: webpSrcset || null,
  };
};

const galleryLayout = (layout, index) => {
  const resolvedLayout = layout || 'auto';

  if (resolvedLayout === 'wide' || resolvedLayout === 'full') {
    return 'full';
  }

  if (index === 0) {
    return 'full';
  }

  if (resolvedLayout === 'portrait') {
    return 'portrait';
  }

  return resolvedLayout === 'auto' ? 'landscape' : resolvedLayout;
};

const galleryItems = gallery.map((img, index) => ({
  type: 'image',
  img,
  index,
  layout: galleryLayout(img.layout, index),
}));

const rowPattern = [1, 2, 1, 2];
const galleryRows = [];
let galleryQuoteIndex = 0;

for (let index = 0; index < galleryItems.length;) {
  const item = galleryItems[index];

  if (item.layout === 'full') {
    galleryRows.push({
      type: 'images',
      layout: 'full',
      index: item.index,
      items: [item],
    });
    index += 1;
    continue;
  }

  const targetCount = rowPattern[galleryRows.length % rowPattern.length];
  const remaining = galleryItems.length - index;

  if (targetCount === 2 && galleryQuoteIndex < projectQuotes.length && remaining > 0) {
    const quoteItem = {
      type: 'quote',
      quote: projectQuotes[galleryQuoteIndex],
      index: item.index + 0.5,
      layout: 'quote',
    };
    const rowItems = galleryQuoteIndex % 2 === 0 ? [item, quoteItem] : [quoteItem, item];

    galleryRows.push({
      type: 'images',
      layout: 'count-2',
      index: item.index,
      items: rowItems,
    });

    index += 1;
    galleryQuoteIndex += 1;
    continue;
  }

  const rowCount = Math.min(targetCount, remaining);
  const rowItems = galleryItems.slice(index, index + rowCount);

  galleryRows.push({
    type: 'images',
    layout: rowItems.length === 1 ? 'full' : `count-${rowItems.length}`,
    index: rowItems[0].index,
    items: rowItems,
  });

  index += rowCount;
}

while (galleryQuoteIndex < projectQuotes.length) {
  galleryRows.push({
    type: 'images',
    layout: 'full',
    index: gallery.length + galleryQuoteIndex,
    items: [
      {
        type: 'quote',
        quote: projectQuotes[galleryQuoteIndex],
        index: gallery.length + galleryQuoteIndex,
        layout: 'quote',
      },
    ],
  });
  galleryQuoteIndex += 1;
}

const heroSources = optimizedImage(heroImage);
const heroPosterSources = optimizedImage(heroPosterImage);
const navigationProjects = [previousProject, nextProject, alternateProject]
  .filter(Boolean)
  .filter((item) => item.slug !== project.slug)
  .filter((item, index, items) => items.findIndex((projectItem) => projectItem.slug === item.slug) === index)
  .map((item) => ({
    ...item,
    navigationImage:
      item.cover ||
      item.hero ||
      item.gallery_uploads?.[0] ||
      item.gallery?.[0]?.url,
  }));
const pageTitle = project.seo_title || project.title;
const pageDescription =
  project.seo_description ||
  [`${project.title} by SeenPleen Studio`, project.category, project.subcategory, project.location, project.year]
    .filter(Boolean)
    .join(' / ');

const siteUrl = (Astro.site?.toString() || 'https://seenpleen.com').replace(/\/$/, '');
const projectUrl = new URL(`/projects/${project.slug}/`, siteUrl).toString();
const projectImage =
  heroSources.avif ||
  heroSources.webp ||
  heroImage ||
  heroPosterSources.avif ||
  heroPosterSources.webp ||
  heroPosterImage;
const projectStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: project.title,
  description: pageDescription,
  url: projectUrl,
  image: projectImage ? new URL(projectImage, siteUrl).toString() : undefined,
  creator: {
    '@id': `${siteUrl}/#studio`,
  },
};

const breadcrumbStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Projects',
      item: `${siteUrl}/#projects`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: project.title,
      item: projectUrl,
    },
  ],
};
---

<BaseLayout
  title={`${pageTitle} | SeenPleen Studio`}
  description={pageDescription}
  canonical={`/projects/${project.slug}/`}
  image={projectImage}
  imageAlt={heroAlt}
  type="article"
  structuredData={[projectStructuredData, breadcrumbStructuredData]}
>
  <Header />

  <main class="project-page">
    <section class="project-hero is-revealed">
      {heroVideo ? (
        <video
          src={heroVideo}
          poster={heroPosterSources.avif || heroPosterSources.webp || heroPosterImage}
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          aria-label={heroAlt}
        ></video>
      ) : heroImage ? (
        <picture>
          {heroSources.avifSrcset && (
            <source
              srcset={heroSources.avifSrcset}
              sizes="100vw"
              type="image/avif"
            />
          )}

          {heroSources.webpSrcset && (
            <source
              srcset={heroSources.webpSrcset}
              sizes="100vw"
              type="image/webp"
            />
          )}

          {heroSources.avif && (
            <source srcset={heroSources.avif} type="image/avif" />
          )}

          {heroSources.webp && (
            <source srcset={heroSources.webp} type="image/webp" />
          )}

          <img
            src={heroSources.avif || heroSources.webp || heroImage}
            alt={heroAlt}
            loading="eager"
            fetchpriority="high"
          />
        </picture>
      ) : (
        <div class="project-hero-placeholder"></div>
      )}
    </section>

    <section class="project-heading-block reveal-item">
      <h1>{project.title}</h1>

      {projectMeta.length > 0 && (
        <p class="project-heading-meta">
          {projectMeta.map((item) => item.value).join(' / ')}
        </p>
      )}

      {projectCollaborators.length > 0 && (
        <dl class="project-heading-collaborators">
          {projectCollaborators.map((item) => (
            <div>
              <dt>{item.label}</dt>
              <dd>{item.value}</dd>
            </div>
          ))}
        </dl>
      )}

      {detailParagraphs.length > 0 ? (
        <div class="project-heading-description">
          {detailParagraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
      ) : (
        <div class="project-heading-description">
          <p>Project information will be added soon.</p>
        </div>
      )}
    </section>

    {gallery.length > 0 && (
      <section class="project-gallery">
        {galleryRows.map((entry) => {
          return (
            <div
              class={`project-gallery-row project-gallery-row-${entry.layout} reveal-item`}
              style={`--reveal-delay: ${Math.min(entry.index * 55, 420)}ms`}
            >
              {entry.items.map(({ type, quote, img, index, layout }) => {
                if (type === 'quote') {
                  return (
                    <aside
                      class="project-gallery-item project-gallery-quote-tile"
                      data-gallery-ratio="0.78"
                    >
                      <p>{quote}</p>
                    </aside>
                  );
                }

                const gallerySources = optimizedImage(img.url);

                return (
                  <figure class={`project-gallery-item project-gallery-item-${layout}`}>
                    <picture>
                      {gallerySources.avifSrcset && (
                        <source
                          srcset={gallerySources.avifSrcset}
                          sizes="(max-width: 768px) 100vw, 50vw"
                          type="image/avif"
                        />
                      )}

                      {gallerySources.webpSrcset && (
                        <source
                          srcset={gallerySources.webpSrcset}
                          sizes="(max-width: 768px) 100vw, 50vw"
                          type="image/webp"
                        />
                      )}

                      {gallerySources.avif && (
                        <source srcset={gallerySources.avif} type="image/avif" />
                      )}

                      {gallerySources.webp && (
                        <source srcset={gallerySources.webp} type="image/webp" />
                      )}

                      <img
                        src={gallerySources.avif || gallerySources.webp || img.url}
                        alt={img.alt || project.title}
                        loading={index < 2 ? 'eager' : 'lazy'}
                      />
                    </picture>
                  </figure>
                );
              })}
            </div>
          );
        })}
      </section>
    )}

    {hasPanoramaImages && (
      <section class="project-panorama reveal-item" aria-label="360 views">
        <div class="project-panorama-header">
          <h2>360 View</h2>

          {panoramaImages.length > 1 && (
            <div class="project-panorama-tabs" aria-label="360 image selection">
              {panoramaImages.map((image, index) => (
                <button
                  type="button"
                  class={index === 0 ? 'is-active' : ''}
                  data-panorama-tab={index}
                >
                  {image.title || `View ${index + 1}`}
                </button>
              ))}
            </div>
          )}
        </div>

        <div class="project-panorama-stage">
          {panoramaImages.map((image, index) => (
            <div
              class={`project-panorama-viewer${index === 0 ? ' is-active' : ''}`}
              data-panorama-index={index}
              data-panorama-url={image.url}
              data-panorama-title={image.title || project.title}
              aria-label={image.alt || image.title || `${project.title} 360 view`}
            ></div>
          ))}
        </div>
      </section>
    )}

    {navigationProjects.length > 0 && (
      <section class="project-navigation reveal-item" aria-label="More projects">
        <h2>More Projects</h2>

        <div class="project-navigation-grid">
          {navigationProjects.map((navigationProject, index) => {
            const navigationSources = optimizedImage(navigationProject.navigationImage);
            const navigationMeta = [
              navigationProject.category,
              navigationProject.subcategory,
              navigationProject.year,
            ].filter(Boolean);

            return (
              <a
                href={`/projects/${navigationProject.slug}/`}
                style={`--reveal-delay: ${Math.min(index * 70, 140)}ms`}
              >
                {navigationProject.navigationImage && (
                  <picture>
                    {navigationSources.avifSrcset && (
                      <source
                        srcset={navigationSources.avifSrcset}
                        sizes="(max-width: 768px) 50vw, 50vw"
                        type="image/avif"
                      />
                    )}

                    {navigationSources.webpSrcset && (
                      <source
                        srcset={navigationSources.webpSrcset}
                        sizes="(max-width: 768px) 50vw, 50vw"
                        type="image/webp"
                      />
                    )}

                    {navigationSources.avif && (
                      <source srcset={navigationSources.avif} type="image/avif" />
                    )}

                    {navigationSources.webp && (
                      <source srcset={navigationSources.webp} type="image/webp" />
                    )}

                    <img
                      src={navigationSources.avif || navigationSources.webp || navigationProject.navigationImage}
                      alt={navigationProject.cover_alt || navigationProject.hero_alt || navigationProject.title}
                      loading="lazy"
                    />
                  </picture>
                )}

                <span class="project-navigation-copy">
                  <strong>{navigationProject.title}</strong>

                  {navigationMeta.length > 0 && (
                    <span>{navigationMeta.join(' / ')}</span>
                  )}
                </span>
              </a>
            );
          })}
        </div>
      </section>
    )}
  </main>

  <Footer />

  {hasPanoramaImages && <style is:global set:html={panoramaCss}></style>}

  <script>
    import 'pannellum';

    const fitGalleryRows = () => {
      const rows = document.querySelectorAll(
        '.project-gallery-row-count-2, .project-gallery-row-count-3'
      );
      const isMobileGallery = window.matchMedia('(max-width: 768px)').matches;

      rows.forEach((row) => {
        if (isMobileGallery) {
          row.style.height = '';
          return;
        }

        const images = [...row.querySelectorAll('img')];
        const items = [...row.querySelectorAll('.project-gallery-item')];

        if (
          items.length === 0 ||
          images.some((image) => !image.naturalWidth || !image.naturalHeight)
        ) {
          return;
        }

        row.style.height = '';

        const rowStyle = window.getComputedStyle(row);
        const gap = parseFloat(rowStyle.columnGap || rowStyle.gap) || 0;
        const availableWidth = row.clientWidth - gap * (items.length - 1);
        const ratioSum = items.reduce((sum, item) => {
          const image = item.querySelector('img');
          const fallbackRatio = parseFloat(item.dataset.galleryRatio || '0.78');

          return sum + (image ? image.naturalWidth / image.naturalHeight : fallbackRatio);
        }, 0);
        const fittedHeight = availableWidth / ratioSum;

        row.style.height = `${fittedHeight}px`;
      });
    };

    window.addEventListener('load', fitGalleryRows);
    window.addEventListener('resize', fitGalleryRows);

    document.querySelectorAll('.project-gallery img').forEach((image) => {
      image.addEventListener('load', fitGalleryRows, { once: true });
    });

    const revealItems = document.querySelectorAll('.reveal-item');

    const revealObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-revealed');
            revealObserver.unobserve(entry.target);
          }
        });
      },
      {
        threshold: 0.12,
      }
    );

    revealItems.forEach((item) => revealObserver.observe(item));

    const panoramaViewers = [...document.querySelectorAll('.project-panorama-viewer')];
    const panoramaTabs = [...document.querySelectorAll('[data-panorama-tab]')];
    const initializedPanoramas = new Set();

    const initializePanorama = (viewer) => {
      const index = viewer.dataset.panoramaIndex;

      if (!window.pannellum || initializedPanoramas.has(index)) {
        return;
      }

      window.pannellum.viewer(viewer, {
        type: 'equirectangular',
        panorama: viewer.dataset.panoramaUrl,
        autoLoad: true,
        showControls: true,
        compass: false,
        mouseZoom: false,
        draggable: true,
        title: viewer.dataset.panoramaTitle || '',
      });

      initializedPanoramas.add(index);
    };

    const showPanorama = (targetIndex) => {
      panoramaViewers.forEach((viewer) => {
        const isActive = viewer.dataset.panoramaIndex === targetIndex;
        viewer.classList.toggle('is-active', isActive);

        if (isActive) {
          initializePanorama(viewer);
        }
      });

      panoramaTabs.forEach((tab) => {
        tab.classList.toggle('is-active', tab.dataset.panoramaTab === targetIndex);
      });
    };

    if (panoramaViewers.length > 0) {
      showPanorama('0');
    }

    panoramaTabs.forEach((tab) => {
      tab.addEventListener('click', () => showPanorama(tab.dataset.panoramaTab));
    });
  </script>
</BaseLayout>
