---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import projects from '../../data/projects.json';
import fs from 'node:fs';
import path from 'node:path';

export function getStaticPaths() {
  const visibleProjects = projects
    .filter((project) => !project.hidden)
    .sort((a, b) => {
      const orderA = Number.isFinite(Number(a.order))
        ? Number(a.order)
        : Number.POSITIVE_INFINITY;

      const orderB = Number.isFinite(Number(b.order))
        ? Number(b.order)
        : Number.POSITIVE_INFINITY;

      return orderA - orderB;
    });

  return visibleProjects.map((project, index) => ({
    params: {
      slug: project.slug,
    },
    props: {
      project,
      previousProject:
        visibleProjects[index - 1] || visibleProjects[visibleProjects.length - 1],
      nextProject:
        visibleProjects[index + 1] || visibleProjects[0],
    },
  }));
}

const { project, previousProject, nextProject } = Astro.props;

const heroImage = project.hero || project.cover || project.gallery?.[0]?.url;

const heroAlt =
  project.hero_alt ||
  project.cover_alt ||
  project.title;

const heroMeta = [
  project.category,
  project.subcategory,
  project.location,
  project.year,
].filter(Boolean);

const detailParagraphs = project.details
  ? project.details.split('\n').filter((paragraph) => paragraph.trim().length > 0)
  : [];

const projectQuotes = (project.quotes || [])
  .map((quote) => (typeof quote === 'string' ? quote : quote?.quote))
  .filter((quote) => quote && String(quote).trim().length > 0);

const projectMeta = [
  { label: 'Category', value: project.category },
  { label: 'Subcategory', value: project.subcategory },
  { label: 'Client', value: project.client },
  { label: 'Location', value: project.location },
  { label: 'Year', value: project.year },
  { label: 'Area', value: project.area },
  { label: 'Status', value: project.status },
].filter((item) => item.value && String(item.value).trim().length > 0);

const collaborators = project.collaborators || {};

const projectCollaborators = [
  { label: 'Architect Engineer', value: collaborators.architect_engineer },
  { label: 'Civil Engineer', value: collaborators.civil_engineer },
  { label: 'Mechanical Engineer', value: collaborators.mechanical_engineer },
  { label: 'Construction', value: collaborators.construction },
  { label: 'Photographer', value: collaborators.photographer },
  { label: '3D Artist', value: collaborators.artist_3d },
  { label: 'Decoration', value: collaborators.decoration },
  { label: 'Lighting Design', value: collaborators.lighting_design },
].filter((item) => item.value && String(item.value).trim().length > 0);

const IMAGE_WIDTHS = [480, 768, 1024, 1440, 1920, 2560];

const publicImageExists = (src) => {
  if (!src || !src.startsWith('/')) {
    return false;
  }

  try {
    return fs.existsSync(path.join(process.cwd(), 'public', decodeURIComponent(src).replace(/^\/+/, '')));
  } catch {
    return false;
  }
};

const encodeImageUrl = (src) => {
  if (!src || !src.startsWith('/')) {
    return src;
  }

  return src
    .split('/')
    .map((part, index) => (index === 0 ? part : encodeURIComponent(decodeURIComponent(part))))
    .join('/');
};

const gallery = (project.gallery || []).filter((img) => publicImageExists(img.url));

const optimizedImage = (src) => {
  if (!src || !/\.(jpe?g|png|webp|avif)$/i.test(src)) {
    return {
      original: src,
      avif: null,
      webp: null,
      avifSrcset: null,
      webpSrcset: null,
    };
  }

  const withoutExtension = src
    .replace(/\.(jpe?g|png|webp|avif)$/i, '')
    .replace(/-(480|768|1024|1440|1920|2560)$/i, '');
  const isAvif = /\.avif$/i.test(src);
  const avif = isAvif ? src : `${withoutExtension}.avif`;
  const webp = `${withoutExtension}.webp`;
  const avifSrcset = IMAGE_WIDTHS
    .map((width) => `${withoutExtension}-${width}.avif`)
    .filter(publicImageExists)
    .map((image) => `${encodeImageUrl(image)} ${image.match(/-(480|768|1024|1440|1920|2560)\.avif$/i)?.[1]}w`)
    .join(', ');
  const webpSrcset = IMAGE_WIDTHS
    .map((width) => `${withoutExtension}-${width}.webp`)
    .filter(publicImageExists)
    .map((image) => `${encodeImageUrl(image)} ${image.match(/-(480|768|1024|1440|1920|2560)\.webp$/i)?.[1]}w`)
    .join(', ');

  return {
    original: encodeImageUrl(src),
    avif: publicImageExists(avif) ? encodeImageUrl(avif) : null,
    webp: publicImageExists(webp) ? encodeImageUrl(webp) : null,
    avifSrcset: avifSrcset || null,
    webpSrcset: webpSrcset || null,
  };
};

const galleryLayout = (layout, index) => {
  const resolvedLayout = layout || 'auto';

  if (resolvedLayout === 'wide' || resolvedLayout === 'full') {
    return 'full';
  }

  if (index === 0) {
    return 'full';
  }

  if (resolvedLayout === 'portrait') {
    return 'portrait';
  }

  return resolvedLayout === 'auto' ? 'landscape' : resolvedLayout;
};

const galleryItems = gallery.map((img, index) => ({
  type: 'image',
  img,
  index,
  layout: galleryLayout(img.layout, index),
}));

const rowPattern = [1, 2, 1, 2];
const galleryRows = [];

for (let index = 0; index < galleryItems.length;) {
  const item = galleryItems[index];

  if (item.layout === 'full') {
    galleryRows.push({
      type: 'images',
      layout: 'full',
      index: item.index,
      items: [item],
    });
    index += 1;
    continue;
  }

  const targetCount = rowPattern[galleryRows.length % rowPattern.length];
  const remaining = galleryItems.length - index;
  const rowCount = Math.min(targetCount, remaining);
  const rowItems = galleryItems.slice(index, index + rowCount);

  galleryRows.push({
    type: 'images',
    layout: rowItems.length === 1 ? 'full' : `count-${rowItems.length}`,
    index: rowItems[0].index,
    items: rowItems,
  });

  index += rowCount;
}

const quoteInsertionIndexes = new Set(
  projectQuotes.map((quote, index) =>
    Math.max(0, Math.round(((index + 1) * galleryRows.length) / (projectQuotes.length + 1)) - 1)
  )
);

const galleryEntries = [];
let galleryQuoteIndex = 0;

galleryRows.forEach((row, index) => {
  galleryEntries.push(row);

  if (quoteInsertionIndexes.has(index) && galleryQuoteIndex < projectQuotes.length) {
    galleryEntries.push({
      type: 'quote',
      quote: projectQuotes[galleryQuoteIndex],
      index: row.index + 0.5,
    });
    galleryQuoteIndex += 1;
  }
});

while (galleryQuoteIndex < projectQuotes.length) {
  galleryEntries.push({
    type: 'quote',
    quote: projectQuotes[galleryQuoteIndex],
    index: gallery.length + galleryQuoteIndex,
  });
  galleryQuoteIndex += 1;
}

const heroSources = optimizedImage(heroImage);
const pageTitle = project.seo_title || project.title;
const pageDescription =
  project.seo_description ||
  [`${project.title} by SeenPleen Studio`, project.category, project.subcategory, project.location, project.year]
    .filter(Boolean)
    .join(' / ');

const siteUrl = (Astro.site?.toString() || 'https://seenpleen.com').replace(/\/$/, '');
const projectUrl = new URL(`/projects/${project.slug}/`, siteUrl).toString();
const projectImage = heroSources.avif || heroSources.webp || heroImage;
const projectStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: project.title,
  description: pageDescription,
  url: projectUrl,
  image: projectImage ? new URL(projectImage, siteUrl).toString() : undefined,
  creator: {
    '@id': `${siteUrl}/#studio`,
  },
};

const breadcrumbStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Projects',
      item: `${siteUrl}/#projects`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: project.title,
      item: projectUrl,
    },
  ],
};
---

<BaseLayout
  title={`${pageTitle} | SeenPleen Studio`}
  description={pageDescription}
  canonical={`/projects/${project.slug}/`}
  image={projectImage}
  imageAlt={heroAlt}
  type="article"
  structuredData={[projectStructuredData, breadcrumbStructuredData]}
>
  <Header />

  <main class="project-page">
    <section class="project-hero is-revealed">
      {heroImage ? (
        <picture>
          {heroSources.avifSrcset && (
            <source
              srcset={heroSources.avifSrcset}
              sizes="100vw"
              type="image/avif"
            />
          )}

          {heroSources.webpSrcset && (
            <source
              srcset={heroSources.webpSrcset}
              sizes="100vw"
              type="image/webp"
            />
          )}

          {heroSources.avif && (
            <source srcset={heroSources.avif} type="image/avif" />
          )}

          {heroSources.webp && (
            <source srcset={heroSources.webp} type="image/webp" />
          )}

          <img
            src={heroSources.avif || heroSources.webp || heroImage}
            alt={heroAlt}
            loading="eager"
            fetchpriority="high"
          />
        </picture>
      ) : (
        <div class="project-hero-placeholder"></div>
      )}
    </section>

    <section class="project-heading-block reveal-item">
      <h1>{project.title}</h1>

      {projectMeta.length > 0 && (
        <p class="project-heading-meta">
          {projectMeta.map((item) => item.value).join(' / ')}
        </p>
      )}

      {projectCollaborators.length > 0 && (
        <dl class="project-heading-collaborators">
          {projectCollaborators.map((item) => (
            <div>
              <dt>{item.label}</dt>
              <dd>{item.value}</dd>
            </div>
          ))}
        </dl>
      )}

      {detailParagraphs.length > 0 ? (
        <div class="project-heading-description">
          {detailParagraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
      ) : (
        <div class="project-heading-description">
          <p>Project information will be added soon.</p>
        </div>
      )}
    </section>

    {gallery.length > 0 && (
      <section class="project-gallery">
        {galleryEntries.map((entry) => {
          if (entry.type === 'quote') {
            return (
              <aside
                class="project-gallery-quote reveal-item"
                style={`--reveal-delay: ${Math.min(entry.index * 55, 420)}ms`}
              >
                <p>{entry.quote}</p>
              </aside>
            );
          }

          return (
            <div
              class={`project-gallery-row project-gallery-row-${entry.layout} reveal-item`}
              style={`--reveal-delay: ${Math.min(entry.index * 55, 420)}ms`}
            >
              {entry.items.map(({ img, index, layout }) => {
                const gallerySources = optimizedImage(img.url);

                return (
                  <figure class={`project-gallery-item project-gallery-item-${layout}`}>
                    <picture>
                      {gallerySources.avifSrcset && (
                        <source
                          srcset={gallerySources.avifSrcset}
                          sizes="(max-width: 768px) 100vw, 50vw"
                          type="image/avif"
                        />
                      )}

                      {gallerySources.webpSrcset && (
                        <source
                          srcset={gallerySources.webpSrcset}
                          sizes="(max-width: 768px) 100vw, 50vw"
                          type="image/webp"
                        />
                      )}

                      {gallerySources.avif && (
                        <source srcset={gallerySources.avif} type="image/avif" />
                      )}

                      {gallerySources.webp && (
                        <source srcset={gallerySources.webp} type="image/webp" />
                      )}

                      <img
                        src={gallerySources.avif || gallerySources.webp || img.url}
                        alt={img.alt || project.title}
                        loading={index < 2 ? 'eager' : 'lazy'}
                      />
                    </picture>
                  </figure>
                );
              })}
            </div>
          );
        })}
      </section>
    )}

    {previousProject && nextProject && (
      <nav class="project-navigation reveal-item" aria-label="Project navigation">
        <a href={`/projects/${previousProject.slug}/`}>
          <span>Previous Project</span>
          <strong>{previousProject.title}</strong>
        </a>

        <a href={`/projects/${nextProject.slug}/`}>
          <span>Next Project</span>
          <strong>{nextProject.title}</strong>
        </a>
      </nav>
    )}
  </main>

  <Footer />

  <script>
    const fitGalleryRows = () => {
      const rows = document.querySelectorAll(
        '.project-gallery-row-count-2, .project-gallery-row-count-3'
      );
      const isMobileGallery = window.matchMedia('(max-width: 768px)').matches;

      rows.forEach((row) => {
        if (isMobileGallery) {
          row.style.height = '';
          return;
        }

        const images = [...row.querySelectorAll('img')];

        if (images.length === 0 || images.some((image) => !image.naturalWidth || !image.naturalHeight)) {
          return;
        }

        row.style.height = '';

        const rowStyle = window.getComputedStyle(row);
        const gap = parseFloat(rowStyle.columnGap || rowStyle.gap) || 0;
        const availableWidth = row.clientWidth - gap * (images.length - 1);
        const ratioSum = images.reduce(
          (sum, image) => sum + image.naturalWidth / image.naturalHeight,
          0
        );
        const targetHeight = parseFloat(rowStyle.height);
        const fittedHeight = availableWidth / ratioSum;

        row.style.height = `${Math.min(targetHeight, fittedHeight)}px`;
      });
    };

    window.addEventListener('load', fitGalleryRows);
    window.addEventListener('resize', fitGalleryRows);

    document.querySelectorAll('.project-gallery img').forEach((image) => {
      image.addEventListener('load', fitGalleryRows, { once: true });
    });

    const revealItems = document.querySelectorAll('.reveal-item');

    const revealObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-revealed');
            revealObserver.unobserve(entry.target);
          }
        });
      },
      {
        threshold: 0.12,
      }
    );

    revealItems.forEach((item) => revealObserver.observe(item));
  </script>
</BaseLayout>
