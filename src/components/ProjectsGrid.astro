---
const { projects } = Astro.props;

const IMAGE_WIDTHS = [480, 768, 1024, 1440, 1920, 2560];

const optimizedImage = (src) => {
  if (!src || !/\.(jpe?g|png)$/i.test(src)) {
    return {
      original: src,
      avif: null,
      webp: null,
      avifSrcset: null,
      webpSrcset: null,
    };
  }

  const withoutExtension = src.replace(/\.(jpe?g|png)$/i, '');

  return {
    original: src,
    avif: `${withoutExtension}.avif`,
    webp: `${withoutExtension}.webp`,
    avifSrcset: IMAGE_WIDTHS.map((width) => `${withoutExtension}-${width}.avif ${width}w`).join(', '),
    webpSrcset: IMAGE_WIDTHS.map((width) => `${withoutExtension}-${width}.webp ${width}w`).join(', '),
  };
};
---

<div class="projects-grid">
  {projects.map((p) => {
    const imageSources = optimizedImage(p.cover);

    return (
      <a class="project-card" href={`/projects/${p.slug}/`}>
        <div class="project-card-image">
          <picture>
            {imageSources.avifSrcset && (
              <source
                srcset={imageSources.avifSrcset}
                sizes="(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 25vw"
                type="image/avif"
              />
            )}

            {imageSources.webpSrcset && (
              <source
                srcset={imageSources.webpSrcset}
                sizes="(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 25vw"
                type="image/webp"
              />
            )}

            <img
              src={p.cover}
              alt={p.title}
              loading="lazy"
            />
          </picture>
        </div>

        <div class="project-card-meta">
          <h3>{p.title}</h3>
          <span>{p.year || p.project_id}</span>
        </div>
      </a>
    );
  })}
</div>
